# Local Docker Compose settings. Copy to .env for local use only.
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ai_incident_analyzer
# Compose builds its local DATABASE_URL from DB_USER/DB_PASSWORD/DB_NAME.
# For a direct/cloud database, set DATABASE_URL to its complete connection URI.
REDIS_URL=redis://redis:6379/0

# Replace before any public deployment. Generate with a cryptographically secure random value.
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# Optional AI integration
GEMINI_API_KEY=

# Local Qdrant service settings
QDRANT_HOST=http://qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=local-qdrant-key
QDRANT_COLLECTION_NAME=incidents

MAX_UPLOAD_SIZE_MB=5
MAX_ANALYSIS_LOG_CHARS=30000
UPLOAD_DIRECTORY=/app/uploads/logs

# Vite reads this at build time. Override for Docker/Vercel builds as needed.
VITE_API_BASE_URL=http://localhost:8000/api
